<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.uianp308p.q20backgroundservice">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/android_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/android_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.UIANP308P_App">
        <activity
            android:name=".Q20BackgroundServiceActivity"
            android:exported="true"
            android:theme="@style/Theme.UIANP308P_App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".Q20MyBackgroundService" android:exported="false" />

    </application>
</manifest>
